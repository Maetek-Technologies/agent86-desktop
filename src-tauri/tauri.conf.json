{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent 86",
  "version": "../package.json",
  "identifier": "com.maetek.agent86.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent 86",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: asset:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A desktop app for the agent86 coding agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Maetek Technologies",
    "copyright": "Copyright (c) 2026 Maetek Technologies. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/Maetek-Technologies/agent86-desktop",
    "longDescription": "Agent 86 is a desktop app for the agent86 coding agent: threads in tabs, tool cards with diffs, approvals, sessions shared with the agent86 CLI, memory, secrets, skills, and specialists.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3N0RBNEIwODlCQkY4MjMKUldRaitMdUpzS1I5aDBPTWdxb0tTQzFXUXkzalB0c1FWVkYyeFVERU0vanl4OU1HZ2FWcUIrUk4K",
      "endpoints": [
        "https://github.com/Maetek-Technologies/agent86-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
